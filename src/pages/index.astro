---
import { getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pageTitle = page?.data.title;
const pageContent = page?.data.content;
const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: "/",
			defaultDescription:
				"iOS・iPadOSのための、美しく軽快なプライベート家計簿。SwiftUI・SwiftData・Swift Charts、ジャンル別日額・月額予算、リマインダー通知、安心の完全ローカル＆iCloud同期。",
		})
	: null;
---

<Base
	title={seo?.title !== "Home" ? seo?.title : undefined}
	pageTitle={pageTitle}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		page && pageContent ? (
			<div {...page.edit.content}>
				<MarketingBlocks value={pageContent} />
			</div>
		) : (
			<div class="empty-state">
				<h1>Personal Kakeibo へようこそ</h1>
				<p>管理画面からコンテンツを編集できます。</p>
					{Astro.locals.user && (
						<a href="/_emdash/admin" class="btn btn-primary">
							管理画面を開く
						</a>
					)}
			</div>
		)
	}
</Base>

<style>
	.empty-state {
		text-align: center;
		padding: var(--spacing-5xl) var(--spacing-lg);
		max-width: var(--max-width);
		margin: 0 auto;
	}

	.empty-state h1 {
		margin-bottom: var(--spacing-md);
	}

	.empty-state p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}
</style>
