---
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import { pagesData } from "../data/site";

const page = pagesData.pricing;
---

<Base
	title="料金プラン"
	pageTitle={page.title}
	description="Personal Kakeibo の料金プラン。広告なし・サブスクなし・隠れた費用ゼロの完全無料でご利用いただけます。"
>
	<div>
		<MarketingBlocks value={page.content} />
	</div>
</Base>
